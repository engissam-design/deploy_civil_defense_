<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.webServer>
        <webSocket enabled="true" />
        <rewrite>
            <rules>
                <rule name="DaphneProxy" stopProcessing="true">
                    <match url="(.*)" />
                    <action type="Rewrite" url="http://172.16.16.200:8002/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>